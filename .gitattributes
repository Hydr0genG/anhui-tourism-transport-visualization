# Normalize Windows acceptance reports in Git while retaining their local originals.
data_foundation/acceptance/D-2026-10-11/*.json text eol=lf

# Source snapshots, extracted text, CSVs and manifests are checked by SHA-256.
# Preserve their exact bytes on every platform, including Windows checkouts.
data_foundation/real_data/** -text

# Published release digests refer to exact bytes. Windows CRLF checkout must not
# change immutable manifests/receipts or binary delivery files.
data_foundation/release/*.contents.json -text
data_foundation/release/*.receipt.json -text
data_foundation/release/*.whl -text
data_foundation/release/*.zip -text

# Received E Windows receipts and actual JSON fixtures retain upstream bytes.
data_foundation/acceptance/C-E051-knowledge-2026-10-15/upstream/** -text
data_foundation/acceptance/C-E051-knowledge-2026-10-15/*.xml -text
